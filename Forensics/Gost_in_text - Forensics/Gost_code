from pathlib import Path

data = Path("audit_report.txt").read_bytes()
text = data.decode("utf-8", errors="replace")

print("[+] File size:", len(data))
print("[+] Trailing whitespace per line:")

for i, line in enumerate(text.splitlines(), 1):
    trailing = line[len(line.rstrip(" \t")):]
    if trailing:
        print(f"Line {i:3}: spaces={trailing.count(' ')}, "
              f"tabs={trailing.count(chr(9))}, "
              f"total={len(trailing)}")

print("\n[+] Non-ASCII characters:")
for i, ch in enumerate(text):
    if ord(ch) > 127:
        print(f"Position {i}: U+{ord(ch):04X}")

